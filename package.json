{
  "name": "portfolio-tulius",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/generate-seo.mjs && node scripts/report-bundle.mjs",
    "preview": "vite preview",
    "format": "oxfmt",
    "format:check": "oxfmt --check src package.json tsconfig.json vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "smoke:prod": "node --use-env-proxy scripts/smoke-production.mjs",
    "smoke:build": "node scripts/smoke-build.mjs"
  },
  "dependencies": {
    "@supabase/postgrest-js": "2.118.0",
    "@supabase/supabase-js": "^2.118.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.9.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.74.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5",
    "vitest": "^5.0.5"
  }
}
